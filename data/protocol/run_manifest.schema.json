{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "New-study scientific run manifest",
  "type": "object",
  "required": [
    "study_id",
    "case_id",
    "stage",
    "execution_location",
    "code_commit",
    "inputs",
    "config_sha256",
    "seeds",
    "reference_backend",
    "counts",
    "outputs",
    "cost",
    "errors"
  ],
  "properties": {
    "study_id": {
      "const": "restart-v1"
    },
    "case_id": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "mean_point",
        "physics_validation",
        "training",
        "model_freeze",
        "pilot",
        "final_MC",
        "distribution_query",
        "report",
        "reproduction"
      ]
    },
    "execution_location": {
      "type": "object",
      "required": [
        "provider",
        "tool",
        "OS",
        "cwd",
        "python",
        "CPU_threads",
        "UTC_time",
        "available_space_bytes"
      ],
      "properties": {
        "provider": {
          "const": "OpenAI-hosted"
        }
      }
    },
    "code_commit": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "config_sha256": {
      "type": "string"
    },
    "seeds": {
      "type": "object"
    },
    "reference_backend": {
      "type": "object",
      "required": [
        "actual_name",
        "actual_version",
        "Q_control_version"
      ]
    },
    "counts": {
      "type": "object",
      "required": [
        "attempted",
        "evaluated",
        "unevaluated_by_reason",
        "AC_inner_calls",
        "controller_outer_steps"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes",
          "storage_status"
        ]
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "wall_seconds",
        "CPU_seconds",
        "monetary_cost_status"
      ],
      "properties": {
        "monetary_cost_status": {
          "enum": [
            "measured",
            "unknown"
          ]
        }
      }
    },
    "errors": {
      "type": "array"
    },
    "model_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
